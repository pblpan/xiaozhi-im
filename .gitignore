# Node / npm
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Flutter / Dart
.dart_tool/
build/
*.apk
*.aab
*.ipa
/android/app/debug/
/android/app/profile/
/android/app/release/

# Python
__pycache__/
*.pyc

# 运行时数据 / 密钥
data/
.env
.env.*
*.db
*.sqlite
*.sqlite3

# 飞牛 NAS 连接凭据（绝不入库。仓库 2026-09-16 已转私有，但仍按公开来防）
deploy/.fnos.env

# ChmlFrp 隧道配置 —— 内含账户 token（user=）与统一鉴权串（token=），等同凭据。
# 只存在于本机 + 飞牛 /vol1/@appdata/chmlfrp/frpc.ini（权限 600），绝不入库。
deploy/.chmlfrp.ini
deploy/.chmlfrp.service.tmp
deploy/.chmlfrp-pkg.tar.gz

# 本机环境快照（如清场前备份的注册表项）—— 只对某台机器有意义，
# 换台机器就是垃圾，且可能带上本机路径，不该进版本库
deploy/backup/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.iml

# vite 构建临时文件（配置打时间戳的中间产物，不该进版本库）
admin/vite.config.js.timestamp-*.mjs

# 验证脚本产出的截图等二进制证据（只对本机那一次运行有意义，不入版本库）
deploy/_prod_shots/
deploy/_ui_check/

# 授权注册机（内含签发私钥，等同产品钥匙）—— 绝不能入库。
# 实体放在工作区之外（桌面「小智 IM/授权注册机」），这里再兜一道，
# 防止哪天图省事把它拷进项目里跟着提交上去。
tools/keygen*
**/keygen.cjs
**/keygen.exe
**/签发记录.log

# 授权凭证：每台机器各自生成，含机器码与授权码，属于运行时数据
license.json

.dart_tool/
build/
*.apk
*.aab
*.ipa
/android/app/debug/
/android/app/profile/
/android/app/release/

# Python
__pycache__/
*.pyc

# 运行时数据 / 密钥
data/
.env
.env.*
*.db
*.sqlite
*.sqlite3

# 飞牛 NAS 连接凭据（绝不入库；本仓库是 Public）
deploy/.fnos.env

# 本机环境快照（如清场前备份的注册表项）—— 只对某台机器有意义，
# 换台机器就是垃圾，且可能带上本机路径，不该进版本库
deploy/backup/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.iml

# vite 构建临时文件（配置打时间戳的中间产物，不该进版本库）
admin/vite.config.js.timestamp-*.mjs

# 验证脚本产出的截图等二进制证据（只对本机那一次运行有意义，不入版本库）
deploy/_prod_shots/
deploy/_ui_check/

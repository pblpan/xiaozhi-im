<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 应用内在线更新：下载 APK 后调起系统安装器（龙哥 2026-10 需求） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 语音消息：录音与音频播放 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 视频通话：摄像头 + 通话中保持屏幕常亮 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 蓝牙耳机（免提切换时需要） -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 蓝牙价签 / 标签打印机的**（经典蓝牙 SPP）**。
         读"已配对设备"、连打印机这两个动作在 Android 12+ 都归 BLUETOOTH_CONNECT
         （上面那条已经有了）；BLUETOOTH_SCAN 只在**主动扫描新设备**时需要，
         这里不扫，加上是为了万一以后要加"扫新机器"。
         neverForLocation = 声明"我不会用蓝牙推断位置" —— 不加这个标记，
         系统会把它当成定位权限追问，用户会莫名其妙（而扫描本来也就用不到位置）。
         BLUETOOTH（旧机型读配对列表要用） -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- 声明了不用就装不上用，索性说清楚：蓝牙打印只跑 Android。 -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- 考勤打卡定位（地理围栏 + 定位防伪）：geolocator 走系统 LocationManager
         （forceLocationManager，见 screens/attendance.dart），不依赖 Google 服务。
         COARSE 是低配兜底；FINE 才拿得到围栏判定需要的米级精度。
         两行都要 —— 只声明 FINE 时部分机型请求弹窗只给"精确"选项，被拒后没有降级路径。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 新消息通知：Android 13（API 33）起发通知要**运行时**授权，
         不在清单里声明的话，系统连弹窗都不会弹、通知直接静默丢弃。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 通知到来时震动。注意：Android 8 起震动由通知通道控制，
         但这条权限在 8 以下仍然要，且缺了它部分机型连通道震动都不生效。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 远程协助「被控端」（手机被别人控制）需要的两条。
         ① 屏幕采集：Android 10（API 29）起 MediaProjection 必须在前台跑，
            Android 14（API 34）起更是强制要求一个 mediaProjection 类型的
            前台服务 —— 缺了它，getMediaProjection() 直接抛 SecurityException，
            现象是"点开始共享，画面永远是黑的"。
            ② 输入注入：Android 明确禁止普通 App 伪造触摸事件，唯一合法的
            通路是无障碍服务。系统会在设置里让用户亲手开一次 —— 那是 Android
            有意设的关卡，不是我们绕不过去的坑。
            ⚠️ 这两条都不在运行时申请（系统权限不给 App 弹窗的资格），
               只能由用户在「设置 → 无障碍」里开。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
        tools:targetApi="34" />
    <application
        android:label="小智IM"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 系统「分享到」：相册 / 文件管理器点分享时要能在候选里看到小智IM。
                 没有下面这段声明，系统根本不会把小智列进分享面板 —— 这不是权限问题，
                 而是"能不能接收"必须在清单里明说。
                 SEND 是单个、SEND_MULTIPLE 是多选，少任何一个都会出现
                 "分享一张图有小智、一次选三张就没有"。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- 出站分享：把导出的账（.txt/.csv）直接交给系统分享面板（微信/企微/钉钉…）。
             Android 7.0 起不允许把 file:// 交给外部 App（FileUriExposedException），
             必须经 FileProvider 转成 content:// 并只授一次性读权限。

             ⚠️ authority 用**独立后缀** `.sharefiles`，刻意不与 open_filex 的
                `${applicationId}.fileProvider.com.crazecoder.openfile` 撞名。
                两个 provider 同 authority 会在安装期就崩，而且报错很难读
                （"Failed to find configured root" / "Couldn't find meta-data"）。
             ⚠️ exported=false + grantUriPermissions=true 是标准组合：
                别人拿不到我们没主动给出去的地址。 -->
        <!-- 屏幕采集前台服务（被控端）。
             foregroundServiceType=mediaProjection 是 Android 14 的硬要求；
             老平台不认识这个属性会自动忽略，所以不用包 targetApi。
             exported=false：这是自己的内部服务，别的应用不该能拉起它。 -->
        <service
            android:name=".RemoteCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 远程控制的输入执行器（被控端）。
             BIND_ACCESSIBILITY_SERVICE 是系统级的绑定权限：只有系统设置能
             把它开起来，普通 App 拿不到 —— 这行少了的话，用户在无障碍列表里
             根本看不到这一项。
             ⚠️ label 与 description 直接决定用户敢不敢开，别写含糊。 -->
        <service
            android:name=".RemoteInputService"
            android:exported="true"
            android:label="@string/remote_input_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_input_service_config" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.sharefiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 出站分享时 MainActivity 会先探一下"有没有 App 认 text/csv 这个具体类型"，
             不认就退到 */* 再拉分享面板。**Android 11+ 不声明可见性，这个探测
             永远返回 null** —— 于是每次都静默走兜底分支：功能看着对，
             但那段代码实际从没生效过（写错 mime 也不会被发现）。
             这里声明 SEND + */* 就够了：intent 里的通配能匹配到任何具体类型，
             一个 */* 覆盖全部能收分享的 App。 -->
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="*/*"/>
        </intent>
        <!-- 卡片消息的「查看详情」按钮要唤起浏览器（Android 11+ 必须显式声明可见性） -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
    </queries>
</manifest>

set +e
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_xiaozhi_common.sh"

xiaozhi_detect_share
xiaozhi_env
xiaozhi_cleanup
xiaozhi_up


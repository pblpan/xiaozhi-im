#!/bin/bash
# ============================================================
#  install_init — 安装前（fnOS 跑 docker compose 之前）必须完成：
#  1) 释放端口（清理同名旧容器/旧网络，支持从旧裸容器升级）
#  2) 解压 app.tgz（fnOS 不会自动解压；不解压就没有 compose 文件）
#  3) 探测共享目录 + 写 docker/.env（关键！否则 fnOS 跑 compose 时
#     ${XIAOZHI_DATA_DIR} 为空 → "invalid spec :/:data" 报错）
# ============================================================
set +e

APPNAME="xiaozhi-im"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# TRIM_APPDEST 由 fnOS 注入；若未注入，回退到 script 父目录（本地 fpk 解包场景）
TRIM_APPDEST="$(echo "${TRIM_APPDEST}" | sed 's:/*$::')"
if [ -z "$TRIM_APPDEST" ]; then
  TRIM_APPDEST="$(cd "$SCRIPT_DIR/.." && pwd)"
fi
SHARE_DIR=""

# 复用 _xiaozhi_common.sh 的函数（保证 detect_share/env 与 callback 完全一致）
source "$SCRIPT_DIR/_xiaozhi_common.sh"

# ---------- 1) 释放端口 ----------
xiaozhi_cleanup

# ---------- 2) 幂等解包 app.tgz ----------
APP_TGZ="${TRIM_APPDEST}/app.tgz"
if [ -f "$APP_TGZ" ]; then
  if [ ! -d "${TRIM_APPDEST}/docker" ] || [ ! -d "${TRIM_APPDEST}/src" ]; then
    cd "${TRIM_APPDEST}"
    tar xzf app.tgz && echo "[$APPNAME] app.tgz 解压完成（docker/、src/、ui/ 已就绪）"
    cd - >/dev/null
  fi
fi

# ---------- 3) 关键步骤：探测数据目录 + 写 .env（在 fnOS 跑 compose 之前）----------
# 这两步必须在 install_init 完成，否则 fnOS 跑 compose 时 ${XIAOZHI_DATA_DIR} 为空报错
xiaozhi_detect_share
xiaozhi_env

exit 0